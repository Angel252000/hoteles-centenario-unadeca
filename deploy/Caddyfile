# Caddy — la opción recomendada. Ver deploy/README.md.
#
# Saca y renueva el certificado de HTTPS solo, redirige HTTP a HTTPS solo, y
# habla HTTP/2 solo. No hay nada de eso que configurar acá abajo, y es la
# razón de recomendarlo: es lo que se rompe cuando nadie mira el servidor en
# dos años.
#
#   caddy run --config /etc/caddy/Caddyfile
#
# Reemplazar SITIO por el dominio real.

SITIO {
	root * /var/www/hoteles

	# Sirve los `.br` y `.gz` que dejó `scripts/precomprimir.mjs` en vez de
	# comprimir en cada pedido. Si el archivo precomprimido no existe, Caddy
	# entrega el original sin quejarse.
	encode {
		zstd
		gzip
	}
	file_server {
		precompressed br gzip
	}

	header {
		# --- Seguridad ---
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		Cross-Origin-Opener-Policy same-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# `frame-ancestors 'none'` es lo que impide que otro sitio enmarque
		# este. El `'unsafe-inline'` de `script-src` no se puede quitar: son
		# 165 scripts en línea distintos entre las trece páginas, la carga de
		# React. Ver la sección 15 de docs/MEJORAS.md.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; frame-src https://www.youtube-nocookie.com https://player.vimeo.com; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"

		# Caddy anuncia su nombre por defecto. Un atacante que no sabe qué
		# corre del otro lado tiene que probar más cosas.
		-Server
	}

	# Las variantes de fotos y los bundles llevan el ancho o el hash en el
	# nombre: si cambia el contenido, cambia la URL. Se cachean para siempre.
	@inmutable path /opt/* /_next/static/*
	header @inmutable Cache-Control "public, max-age=31536000, immutable"

	# El HTML no: tiene que revalidar o nadie ve los cambios al publicar.
	@html path *.html /
	header @html Cache-Control "public, max-age=0, must-revalidate"

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
